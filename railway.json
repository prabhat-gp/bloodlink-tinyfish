{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm ci --include=dev && npm ci --prefix bot --include=dev && npm run build"
  },
  "deploy": {
    "startCommand": "node scripts/start-all.mjs",
    "healthcheckPath": "/api/budget",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
