# Copy to .env.local. Never commit .env.local.

# "mock" (default, zero credits) or "live" (uses TinyFish credits)
BLOODLINK_MODE=mock

# Your TinyFish key from https://agent.tinyfish.ai/api-keys (server-side only)
TINYFISH_API_KEY=

# Spend caps in agent steps ($0.016/step → 250 steps ≈ $4.00)
# SESSION = browser counter (mock + live). DAILY = server ledger in .data/budget.json (live, resets each IST day).
BLOODLINK_SESSION_STEP_CAP=250
BLOODLINK_DAILY_STEP_CAP=250

# Optional: use an existing TinyFish Dataset for the directory (otherwise `npm run setup -- dataset` stores one in .data/)
TINYFISH_DATASET_ID=
