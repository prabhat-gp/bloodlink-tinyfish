# Copy to .env.local. Never commit .env.local.

# "mock" (sample data, zero credits) for local work; production runs "live"
BLOODLINK_MODE=mock

# TinyFish key from https://agent.tinyfish.ai/api-keys (server-side only)
TINYFISH_API_KEY=

# Spend caps in agent steps ($0.016/step → 250 steps ≈ $4.00)
# SESSION = browser counter. DAILY = server ledger in .data/budget.json (resets each IST day).
BLOODLINK_SESSION_STEP_CAP=250
BLOODLINK_DAILY_STEP_CAP=250

# Search: "fast" (TinyFish browser + eRaktKosh's own data request, agent as fallback) or "agent" (always the AI agent)
BLOODLINK_SEARCH=fast
# Minutes an idle TinyFish browser stays open for the next search ($0.002/min)
BLOODLINK_BROWSER_KEEP_WARM_MIN=10

# Optional: existing TinyFish Dataset for the directory (otherwise `npm run setup -- dataset`)
TINYFISH_DATASET_ID=

# Telegram bot (see bot/.env.example; on Railway set these on the same service)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=BloodLinkIndiaBot
# WEB_APP_URL=https://bloodlink-tinyfish-production.up.railway.app
