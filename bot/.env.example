# Copy to bot/.env.local. Never commit .env.local.
# TINYFISH_API_KEY and BLOODLINK_MODE are read from the web app's ../.env.local (shared).

# From @BotFather
TELEGRAM_BOT_TOKEN=
# Bot username without @ (used for share / deep links)
TELEGRAM_BOT_USERNAME=

# Fresh results are reused for this long (minutes). Same search again = instant and free.
CACHE_TTL_MINUTES=15
# How often active alerts re-check eRaktKosh (minutes)
ALERT_INTERVAL_MINUTES=30

# Where "Open in web app" points
WEB_APP_URL=http://localhost:3010
